PORT=5000
# Paste your Firebase service account JSON as a single-line string here
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT_ID",...}

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# HiveMQ Cloud Broker MQTT Credentials
MQTT_CLUSTER_URL=mqtts://YOUR_CLUSTER.s1.eu.hivemq.cloud:8883
HIVEMQ_USERNAME=YOUR_HIVEMQ_USERNAME
HIVEMQ_PASSWORD=YOUR_HIVEMQ_PASSWORD

